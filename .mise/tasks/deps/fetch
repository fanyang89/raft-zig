#!/usr/bin/env bash
#MISE description="Fetch Zig dependencies through proxy-aware clients"
set -euo pipefail

command -v zigfetch >/dev/null

cache_root="${ZIG_GLOBAL_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/zig}"
package_root="zig-pkg"
mkdir -p "$cache_root/p" "$cache_root/tmp" "$package_root"

fetch_package() {
    local package="$1"
    local url="$2"
    if [[ -d "$package_root/$package" ]]; then
        return
    fi

    zigfetch --no-dep "$url"
    [[ -d "$cache_root/p/$package" ]]
    cp -a "$cache_root/p/$package" "$package_root/$package"
}

